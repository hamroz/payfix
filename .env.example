# Copy to .env.local. `npm run setup:devnet` fills in the Solana values for you.

APP_URL=http://localhost:3000
# Used to sign session cookies. Any long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Postgres. With `npm run db:up` (Docker) use:
#   DATABASE_URL=postgres://payfix:payfix@127.0.0.1:55432/payfix
# Leave empty to fall back to the embedded PGlite in .data/pglite (one process at a time).
# `docker compose up` sets this for the app container itself.
DATABASE_URL=

# Empty = simulated chain until setup:devnet creates the test mint, then "devnet".
# "mainnet-beta" = production: real USDC, demo mode off, a paid RPC URL strongly recommended.
SOLANA_CLUSTER=
# Empty = the cluster's public endpoint.
SOLANA_RPC_URL=

# The one explicitly configured token mint. Empty on mainnet = Circle's USDC.
PAYFIX_MINT=
PAYFIX_MINT_DECIMALS=6
# Empty = "Test USD" off mainnet, "USDC" on mainnet.
PAYFIX_TOKEN_LABEL=

# Demo mode adds a dev mailbox, demo wallets, and a test-token faucet. Devnet only.
DEMO_MODE=true
DEMO_TREASURY_SECRET=
DEMO_MERCHANT_SECRET=
DEMO_CUSTOMER_SECRET=

# Demo mode off (production): sign-in codes and links are emailed through Resend.
RESEND_API_KEY=
# A sender on a domain verified in Resend. Empty = Resend's test sender (owner's inbox only).
EMAIL_FROM=
# Production site only: where "Try the live demo" points (the devnet deployment).
DEMO_URL=
