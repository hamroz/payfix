# Copy to .env.local. `npm run setup:devnet` fills in the Solana values for you.

APP_URL=http://localhost:3000
# Used to sign session cookies. Any long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Leave empty to use the embedded Postgres (PGlite) stored in .data/pglite.
# Set to a Postgres URL (e.g. Neon) for deployments.
DATABASE_URL=

SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# The one explicitly configured test-token mint. Never a mainnet mint in demo mode.
PAYFIX_MINT=
PAYFIX_MINT_DECIMALS=6
PAYFIX_TOKEN_LABEL=Test USD

# Demo mode adds a dev mailbox, demo wallets, and a test-token faucet. Devnet only.
DEMO_MODE=true
DEMO_TREASURY_SECRET=
DEMO_MERCHANT_SECRET=
DEMO_CUSTOMER_SECRET=
